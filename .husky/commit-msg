#!/bin/bash

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

PATTERN="^(feat|deliverable|fix|chore|refactor|docs|test|perf|style|build)(\([a-zA-Z0-9._/-]+\))?: (\[[A-Z0-9_]+-[0-9]+\] )?.+"

RED='\033[0;31m'
NC='\033[0m'

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo "${RED}****** ERROR: Commit message does not follow the required format ******${RED}"
  echo ""
  echo "** Expected format:"
  echo "   <type>(<scope>):<TAG>-<NUMBER> <description>"
  echo ""
  echo "** Where:"
  echo "   - type        = feat | fix | chore | refactor | docs | test | perf | style | build"
  echo "   - scope       = path or module name (e.g., components)"
  echo "   - TAG         = uppercase identifier (e.g., TECH)"
  echo "   - NUMBER      = issue or task number (e.g., 3051)"
  echo "   - description = a meaningful, descriptive commit summary"
  echo ""
  echo "** Example:"
  echo "   feat(hooks):TECH-21 Add useFormat to isolate strings across modules"
  echo ""
  exit 1
fi

exit 0
exit 0
