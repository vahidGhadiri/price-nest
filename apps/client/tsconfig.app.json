{
    "extends": "./tsconfig.base.json",

    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@infrastructure/*": ["src/ـinfrastructure/*"],
            "@domain/*": ["src/ـdomain/*"],
            "@config/*": ["src/config/*"],
            "@utils/*": ["src/utils/*"]
        },

        "plugins": [{ "name": "next" }]
    },

    "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "global.d.ts"],

    "exclude": ["node_modules"]
}
