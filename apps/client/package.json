{
    "name": "client",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "prebuild": "yarn i18n",
        "build": "next build",
        "dev": "next dev",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "imports:check": "node scripts/sort-imports.mjs --check .",
        "imports:fix": "node scripts/sort-imports.mjs --write .",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "dep:check": "depcruise src --config .dependency-cruiser.js",
        "clean": "rimraf .next coverage",
        "i18n": "formatjs extract 'src/**/*.(j|t)s*' --out-file src/configs/i18n/fa.json --ignore 'src/**/*.d.ts' && formatjs compile src/configs/i18n/fa.json --ast --out-file src/configs/i18n/compiled/fa.json",
        "types:fix": "eslint src --fix",
        "lint:fix": "node scripts/lint.mjs --fix",
        "lint:check": "node scripts/lint.mjs --check",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@tanstack/react-query": "^5.101.2",
        "next": "^16.0.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.2",
        "@tanstack/react-query-devtools": "^5.101.2",
        "@types/node": "^24.10.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/eslint-plugin": "^1.3.0",
        "@vitest/ui": "^3.2.4",
        "dependency-cruiser": "^17.2.0",
        "eslint": "^9.39.0",
        "eslint-config-next": "^16.0.1",
        "eslint-plugin-perfectionist": "^4.15.0",
        "eslint-plugin-prettier": "^5.5.4",
        "jsdom": "^27.0.0",
        "postcss": "^8.5.16",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "tailwindcss": "^4.3.2",
        "tsx": "^4.19.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.0",
        "vite": "^7.1.7",
        "vitest": "^3.2.4"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "node scripts/lint.mjs --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,scss,html}": [
            "prettier --write"
        ]
    }
}
