{
    "printWidth": 180,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "bracketSameLine": true,
    "singleAttributePerLine": false,
    "proseWrap": "never",
    "objectWrap": "preserve",
    "endOfLine": "lf"
}
