{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "author": "vahid ghadiri <ghadiri.vahid@tapsi.doctor>",
  "license": "MIT",
  "scripts": {
    "build:stage:preview": "yarn i18n:export-lang && NEXT_PUBLIC_ENV=staging next build && NODE_ENV=production yarn start -p 4000",
    "build:prod:preview": "yarn i18n:export-lang && next build && NODE_ENV=production yarn start -p 5000",
    "build:stage": "yarn i18n:export-lang && NEXT_PUBLIC_ENV=staging next build",
    "start:prod": "NODE_ENV=production next start -p 3000",
    "build:prod": "yarn i18n:export-lang && next build",
    "start:stage": "NODE_ENV=production NEXT_PUBLIC_ENV=staging next start -p 3000",
    "build:dev": "yarn i18n:export-lang && next dev",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "imports:fix": "node scripts/sort-imports.mjs --write .",
    "imports:check": "node scripts/sort-imports.mjs --check .",
    "test:run": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "dep:check": "depcruise src --config .dependency-cruiser.js",
    "i18n:export-lang": "formatjs extract 'src/**/*.(j|t)s*' --out-file src/configs/i18n/fa.json --ignore 'src/**/*.d.ts' && formatjs compile src/configs/i18n/fa.json --ast --out-file src/configs/i18n/compiled/fa.json",
    "prepare": "husky"
  },
  "dependencies": {
    "react-dom": "^18.2.0",
    "react": "^18.2.0",
    "next": "^14.0.0"
  },
  "devDependencies": {
    "eslint-config-next": "^14.0.0",
    "dependency-cruiser": "^16.0.0",
    "@types/react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0"
  }
}
