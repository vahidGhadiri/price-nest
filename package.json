{
  "name": "price-nest",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:client": "turbo run dev --filter=client",
    "dev:server": "dotnet watch run --project apps/server/src/PriceNest.Server",
    "dev:crawler": "dotnet watch run --project apps/crawler/src/PriceNest.Crawler"
  },
  "devDependencies": {
    "turbo": "^2.10.4"
  },
  "packageManager": "yarn@1.22.22"
}
